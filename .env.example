# Suno API for Music Generation
# Get your API key from https://sunoapi.org
SUNO_API_KEY=your_suno_api_key_here

# Railway Redis for IP tracking
# Format: redis://default:password@host:port
REDIS_URL=redis://default:your_password@your_host.railway.app:6379

# Solana Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# LV Token Configuration (public - accessible in browser)
NEXT_PUBLIC_LV_TOKEN_MINT=your_token_mint_address_here
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
